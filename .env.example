# For local development, set these to the assay-dev project in ignored .env.local.
# Vercel Preview and Production each need their corresponding environment-specific values.
# The Vite build derives CSP img-src/connect-src from VITE_SUPABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only API configuration. Keep the service-role key out of VITE_ variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
INVITATION_DAILY_LIMIT=20
